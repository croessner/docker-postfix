@@ -75,6 +84,11 @@
 /*	only once, and does not wait until the cleanup service is
 /*	available.  Otherwise it is identical to post_mail_fopen().
 /*
+/*	post_mail_fopen_dsn_nowait() is a bounce(8)-specific interface
+/*	for posting a locally-generated delivery status notification.
+/*	The sender must be the null address and the source class must
+/*	be MAIL_SRC_MASK_BOUNCE.
+/*
 /*	post_mail_fopen_async() contacts the cleanup service and
 /*	invokes the caller-specified notify routine, with the
 /*	open stream and the caller-specified context when the
@@ -218,7 +232,8 @@ typedef struct {
 static void post_mail_init(VSTREAM *stream, const char *sender,
 			           const char *recipient,
 			           int source_class, int trace_flags,
-			           int sendopts, VSTRING *queue_id)
+			           int sendopts, int dsn_origin,
+			           VSTRING *queue_id)
 {
     VSTRING *id = queue_id ? queue_id : vstring_alloc(100);
     struct timeval now;
@@ -227,7 +242,8 @@ static void post_mail_init(VSTREAM *stream, const char *sender,
     int_filt_flags(source_class) | CLEANUP_FLAG_MASK_INTERNAL
     | smtputf8_autodetect(source_class)
     | ((sendopts & SOPT_REQUIRETLS_ESMTP) ? CLEANUP_FLAG_REQTLS : 0)
-    | ((sendopts & SMTPUTF8_FLAG_REQUESTED) ? CLEANUP_FLAG_SMTPUTF8 : 0);
+    | ((sendopts & SMTPUTF8_FLAG_REQUESTED) ? CLEANUP_FLAG_SMTPUTF8 : 0)
+    | (dsn_origin ? CLEANUP_FLAG_DSN_ORIGIN : 0);
 
     GETTIMEOFDAY(&now);
     date = mail_date(now.tv_sec);
@@ -297,7 +313,7 @@ VSTREAM *post_mail_fopen(const char *sender, const char *recipient,
 
     stream = mail_connect_wait(MAIL_CLASS_PUBLIC, var_cleanup_service);
     post_mail_init(stream, sender, recipient, source_class, trace_flags,
-		   sendopts, queue_id);
+		   sendopts, 0, queue_id);
     return (stream);
 }
 
@@ -312,7 +328,27 @@ VSTREAM *post_mail_fopen_nowait(const char *sender, const char *recipient,
     if ((stream = mail_connect(MAIL_CLASS_PUBLIC, var_cleanup_service,
 			       BLOCKING)) != 0)
 	post_mail_init(stream, sender, recipient, source_class, trace_flags,
-		       sendopts, queue_id);
+		       sendopts, 0, queue_id);
+    else
+	msg_warn("connect to %s/%s: %m",
+		 MAIL_CLASS_PUBLIC, var_cleanup_service);
+    return (stream);
+}
+
+/* post_mail_fopen_dsn_nowait - post a local bounce(8) DSN */
+
+VSTREAM *post_mail_fopen_dsn_nowait(const char *sender, const char *recipient,
+				            int source_class, int trace_flags,
+				            int sendopts, VSTRING *queue_id)
+{
+    VSTREAM *stream;
+
+    if (*sender != 0 || source_class != MAIL_SRC_MASK_BOUNCE)
+	msg_panic("post_mail_fopen_dsn_nowait: invalid argument");
+    if ((stream = mail_connect(MAIL_CLASS_PUBLIC, var_cleanup_service,
+			       BLOCKING)) != 0)
+	post_mail_init(stream, sender, recipient, source_class, trace_flags,
+		       sendopts, 1, queue_id);
     else
 	msg_warn("connect to %s/%s: %m",
 		 MAIL_CLASS_PUBLIC, var_cleanup_service);
@@ -341,7 +377,7 @@ static void post_mail_open_event(int event, void *context)
 	non_blocking(vstream_fileno(state->stream), BLOCKING);
 	post_mail_init(state->stream, state->sender,
 		       state->recipient, state->source_class,
-		       state->trace_flags, state->sendopts,
+		       state->trace_flags, state->sendopts, 0,
 		       state->queue_id);
 	myfree(state->sender);
 	myfree(state->recipient);
