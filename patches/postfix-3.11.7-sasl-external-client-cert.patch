+/* tls_peer_rfc822name - extract unique, wire-safe rfc822Name SAN */
+
+char   *tls_peer_rfc822name(X509 *peercert,
+			            const TLS_SESS_STATE *TLScontext)
+{
+    const char *myname = "tls_peer_rfc822name";
+    general_name_stack_t *names;
+    const GENERAL_NAME *name;
+    const ASN1_IA5STRING *mailbox;
+    const unsigned char *data;
+    char   *result = 0;
+    int     crit = -1;
+    int     count;
+    int     length;
+    int     i;
+    int     j;
+
+    names = X509_get_ext_d2i(peercert, NID_subject_alt_name, &crit, 0);
+    if (names == 0)
+	return (mystrdup(""));
+
+    count = sk_GENERAL_NAME_num(names);
+    for (i = 0; i < count; i++) {
+	name = sk_GENERAL_NAME_value(names, i);
+	if (name->type != GEN_EMAIL)
+	    continue;
+	mailbox = name->d.rfc822Name;
+	length = ASN1_STRING_length(mailbox);
+	data = ASN1_STRING_get0_data(mailbox);
+	if (length <= 0 || length >= CCERT_BUFSIZ || data == 0) {
+	    msg_warn("%s: %s: invalid rfc822Name SAN length",
+		     myname, TLScontext->namaddr);
+	    if (result)
+		myfree(result);
+	    result = 0;
+	    break;
+	}
+	for (j = 0; j < length; j++) {
+	    if (!ISASCII(data[j]) || !ISPRINT(data[j])) {
+		msg_warn("%s: %s: unsafe content in rfc822Name SAN",
+			 myname, TLScontext->namaddr);
+		if (result)
+		    myfree(result);
+		result = 0;
+		break;
+	    }
+	}
+	if (j != length)
+	    break;
+	if (result == 0) {
+	    result = mystrndup((const char *) data, length);
+	} else if ((int) strlen(result) != length
+		   || memcmp(result, data, length) != 0) {
+	    msg_warn("%s: %s: multiple distinct rfc822Name SAN values",
+		     myname, TLScontext->namaddr);
+	    myfree(result);
+	    result = 0;
+	    break;
+	}
+    }
+    GENERAL_NAMES_free(names);
+    return (result ? result : mystrdup(""));
+}
