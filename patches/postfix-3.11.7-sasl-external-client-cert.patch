diff --git a/src/tls/tls_external.c b/src/tls/tls_external.c
new file mode 100644
index 0000000..61bc9bc
--- /dev/null
+++ b/src/tls/tls_external.c
@@ -0,0 +1,142 @@
+#include <sys_defs.h>
+
+#ifdef USE_TLS
+
+#include <stdio.h>
+#include <string.h>
+
+#include <msg.h>
+#include <msg_vstream.h>
+#include <mymalloc.h>
+#include <vstream.h>
+
+#define TLS_INTERNAL
+#include <tls.h>
+
+typedef struct {
+    const unsigned char *data;
+    int     length;
+} TEST_MAILBOX;
+
+static X509 *make_certificate(const TEST_MAILBOX *mailboxes, int count)
+{
+    X509   *cert = X509_new();
+    general_name_stack_t *names;
+    GENERAL_NAME *name;
+    ASN1_IA5STRING *mailbox;
+    int     i;
+
+    if (cert == 0)
+	msg_fatal("X509_new failed");
+    if (count == 0)
+	return (cert);
+    if ((names = sk_GENERAL_NAME_new_null()) == 0)
+	msg_fatal("sk_GENERAL_NAME_new_null failed");
+    for (i = 0; i < count; i++) {
+	if ((name = GENERAL_NAME_new()) == 0
+	    || (mailbox = ASN1_IA5STRING_new()) == 0
+	    || !ASN1_STRING_set(mailbox, mailboxes[i].data,
+				mailboxes[i].length))
+	    msg_fatal("cannot construct rfc822Name");
+	GENERAL_NAME_set0_value(name, GEN_EMAIL, mailbox);
+	if (!sk_GENERAL_NAME_push(names, name))
+	    msg_fatal("cannot append rfc822Name");
+    }
+    if (!X509_add1_ext_i2d(cert, NID_subject_alt_name, names, 0, 0))
+	msg_fatal("cannot add subjectAltName extension");
+    GENERAL_NAMES_free(names);
+    return (cert);
+}
+
+static void check_identity(const char *label, const TEST_MAILBOX *mailboxes,
+			           int count, const char *expected)
+{
+    TLS_SESS_STATE context;
+    X509   *cert;
+    char   *actual;
+
+    memset(&context, 0, sizeof(context));
+    context.namaddr = "unit-test";
+    cert = make_certificate(mailboxes, count);
+    actual = tls_peer_rfc822name(cert, &context);
+    if (strcmp(actual, expected) != 0)
+	msg_fatal("%s: expected <%s>, got <%s>", label, expected, actual);
+    myfree(actual);
+    X509_free(cert);
+}
+
+static void check_resumption_disabled(void)
+{
+    SSL_CTX *server_ctx = SSL_CTX_new(TLS_server_method());
+    SSL_CTX *sni_ctx = SSL_CTX_new(TLS_server_method());
+
+    if (server_ctx == 0 || sni_ctx == 0)
+	msg_fatal("SSL_CTX_new failed");
+    SSL_CTX_set_num_tickets(server_ctx, 2);
+    SSL_CTX_set_num_tickets(sni_ctx, 2);
+    SSL_CTX_set_session_cache_mode(server_ctx, SSL_SESS_CACHE_SERVER);
+    SSL_CTX_set_session_cache_mode(sni_ctx, SSL_SESS_CACHE_SERVER);
+    tls_server_disable_resumption(server_ctx, sni_ctx);
+    if ((SSL_CTX_get_options(server_ctx) & SSL_OP_NO_TICKET) == 0
+	|| (SSL_CTX_get_options(sni_ctx) & SSL_OP_NO_TICKET) == 0
+	|| SSL_CTX_get_num_tickets(server_ctx) != 0
+	|| SSL_CTX_get_num_tickets(sni_ctx) != 0
+	|| SSL_CTX_get_session_cache_mode(server_ctx) != SSL_SESS_CACHE_OFF
+	|| SSL_CTX_get_session_cache_mode(sni_ctx) != SSL_SESS_CACHE_OFF)
+	msg_fatal("CRL policy did not disable all TLS session resumption");
+    SSL_CTX_free(server_ctx);
+    SSL_CTX_free(sni_ctx);
+}
+
+int     main(int argc, char **argv)
+{
+    static const unsigned char alice[] = "alice@example.test";
+    static const unsigned char bob[] = "bob@example.test";
+    static const unsigned char with_nul[] = "alice\0@example.test";
+    static const unsigned char with_tab[] = "alice\t@example.test";
+    static const unsigned char with_cr[] = "alice\r@example.test";
+    static const unsigned char with_lf[] = "alice\n@example.test";
+    static const unsigned char non_ascii[] = {
+	'a', 'l', 'i', 'c', 'e', 0x80, '@', 'e', 'x', 'a', 'm', 'p', 'l', 'e'
+    };
+    static const TEST_MAILBOX one[] = {
+	{alice, sizeof(alice) - 1}
+    };
+    static const TEST_MAILBOX duplicate[] = {
+	{alice, sizeof(alice) - 1}, {alice, sizeof(alice) - 1}
+    };
+    static const TEST_MAILBOX distinct[] = {
+	{alice, sizeof(alice) - 1}, {bob, sizeof(bob) - 1}
+    };
+    static const TEST_MAILBOX nul_value[] = {
+	{with_nul, sizeof(with_nul) - 1}
+    };
+    static const TEST_MAILBOX tab_value[] = {
+	{with_tab, sizeof(with_tab) - 1}
+    };
+    static const TEST_MAILBOX cr_value[] = {
+	{with_cr, sizeof(with_cr) - 1}
+    };
+    static const TEST_MAILBOX lf_value[] = {
+	{with_lf, sizeof(with_lf) - 1}
+    };
+    static const TEST_MAILBOX non_ascii_value[] = {
+	{non_ascii, sizeof(non_ascii)}
+    };
+
+    msg_vstream_init(argv[0], VSTREAM_ERR);
+    check_identity("single", one, 1, (const char *) alice);
+    check_identity("duplicate", duplicate, 2, (const char *) alice);
+    check_identity("distinct", distinct, 2, "");
+    check_identity("absent", 0, 0, "");
+    check_identity("NUL", nul_value, 1, "");
+    check_identity("TAB", tab_value, 1, "");
+    check_identity("CR", cr_value, 1, "");
+    check_identity("LF", lf_value, 1, "");
+    check_identity("non-ASCII", non_ascii_value, 1, "");
+    check_resumption_disabled();
+    vstream_fprintf(VSTREAM_OUT, "tls_external: PASS\n");
+    return (0);
+}
+
+#endif
