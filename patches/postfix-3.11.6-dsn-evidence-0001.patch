+/* bounce_mail_fopen - post a null-sender DSN with origin evidence */
+
+VSTREAM *bounce_mail_fopen(BOUNCE_INFO *bounce_info, const char *recipient,
+			           int source_class, int trace_flags,
+			           int sendopts, VSTRING *queue_id)
+{
+    if (LEN(bounce_info->dsn_original_envelope) > 0)
+	return (post_mail_fopen_dsn_nowait(MAIL_ADDR_EMPTY, recipient,
+					    source_class, trace_flags,
+					    sendopts, queue_id,
+					    STR(bounce_info->dsn_original_envelope)));
+    return (post_mail_fopen_nowait(MAIL_ADDR_EMPTY, recipient, source_class,
+				  trace_flags, sendopts, queue_id));
+}
