@@ -218,6 +220,51 @@
 #define STR vstring_str
 #define LEN VSTRING_LEN
 
+#define BOUNCE_DSN_EVIDENCE_VERSION	1
+#define BOUNCE_DSN_ADDRESS_LIMIT	254
+#define BOUNCE_DSN_RECIPIENT_LIMIT	256
+#define BOUNCE_DSN_DECODED_LIMIT	(47 * 1024)
+
+/* bounce_dsn_put_u16 - append a big-endian unsigned 16-bit value */
+
+static void bounce_dsn_put_u16(VSTRING *buffer, ssize_t value)
+{
+    VSTRING_ADDCH(buffer, (value >> 8) & 0xff);
+    VSTRING_ADDCH(buffer, value & 0xff);
+}
+
+/* bounce_dsn_envelope_encode - encode the original SMTP envelope */
+
+static void bounce_dsn_envelope_encode(BOUNCE_INFO *bounce_info)
+{
+    VSTRING *raw = vstring_alloc(100);
+    char  **recipient;
+
+    VSTRING_ADDCH(raw, BOUNCE_DSN_EVIDENCE_VERSION);
+    bounce_dsn_put_u16(raw, LEN(bounce_info->dsn_sender));
+    vstring_memcat(raw, STR(bounce_info->dsn_sender),
+		   LEN(bounce_info->dsn_sender));
+    bounce_dsn_put_u16(raw, bounce_info->dsn_recipients->argc);
+    for (recipient = bounce_info->dsn_recipients->argv;
+	 *recipient != 0; recipient++) {
+	bounce_dsn_put_u16(raw, strlen(*recipient));
+	vstring_strcat(raw, *recipient);
+    }
+    if (LEN(raw) > BOUNCE_DSN_DECODED_LIMIT) {
+	vstring_free(raw);
+	return;
+    }
+    base64_encode(bounce_info->dsn_original_envelope, STR(raw), LEN(raw));
+    translit(STR(bounce_info->dsn_original_envelope), "+/", "-_");
+    while (LEN(bounce_info->dsn_original_envelope) > 0
+	   && STR(bounce_info->dsn_original_envelope)
+	   [LEN(bounce_info->dsn_original_envelope) - 1] == '=')
+	vstring_truncate(bounce_info->dsn_original_envelope,
+			 LEN(bounce_info->dsn_original_envelope) - 1);
+    VSTRING_TERMINATE(bounce_info->dsn_original_envelope);
+    vstring_free(raw);
+}
