+/* open_test_state - allocate state with a writable queue stream */
+
+static CLEANUP_STATE *open_test_state(void)
+{
+    CLEANUP_STATE *state = cleanup_state_alloc((VSTREAM *) 0);
+
+    state->queue_id = mystrdup("TEST");
+    if ((state->dst = vstream_fopen("/dev/null", O_WRONLY, 0)) == 0)
+	msg_fatal("vstream_fopen(\"/dev/null\", O_WRONLY, 0): %m");
+    return (state);
+}
+
+/* close_test_state - close queue stream and release state */
+
+static void close_test_state(CLEANUP_STATE *state)
+{
+    (void) vstream_fclose(state->dst);
+    state->dst = 0;
+    cleanup_state_free(state);
+}
