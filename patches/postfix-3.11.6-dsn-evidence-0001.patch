+		|| state->dsn_original_envelope != 0
+		|| cleanup_dsn_envelope_ok(attr_value) == 0) {
+		msg_warn("%s: message rejected: invalid DSN origin evidence",
+			 state->queue_id);
+		state->errs |= CLEANUP_STAT_BAD;
+		return;
+	    }
+	    state->dsn_original_envelope = mystrdup(attr_value);
+	    return;
+	}
 	/* Zero-length values are place holders for unavailable values. */
 	if (*attr_value == 0) {
 	    msg_warn("%s: spurious null attribute value for \"%s\" -- ignored",
@@ -335,6 +363,14 @@ static void cleanup_envelope_process(CLEANUP_STATE *state, int type,
