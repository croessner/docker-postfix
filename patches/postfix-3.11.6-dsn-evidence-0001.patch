 static void cleanup_envelope_process(CLEANUP_STATE *, int, const char *, ssize_t);
 
+#define CLEANUP_DSN_ENVELOPE_MAX	((47 * 1024 * 4 + 2) / 3)
+
+/* cleanup_dsn_envelope_ok - validate unpadded base64url transport value */
+
+static int cleanup_dsn_envelope_ok(const char *value)
+{
+    const unsigned char *cp;
+
+    if (*value == 0 || strlen(value) > CLEANUP_DSN_ENVELOPE_MAX)
+	return (0);
+    for (cp = (const unsigned char *) value; *cp; cp++)
+	if (!ISALNUM(*cp) && *cp != '-' && *cp != '_')
+	    return (0);
+    return (1);
+}
