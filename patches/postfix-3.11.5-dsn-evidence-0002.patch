+	rejects_untrusted_dsn_evidence,
+    },
+    {"rejects_duplicate_dsn_evidence",
+	rejects_duplicate_dsn_evidence,
+    },
+    {"rejects_incomplete_dsn_evidence",
+	rejects_incomplete_dsn_evidence,
+    },
+    {"rejects_malformed_dsn_evidence",
+	rejects_malformed_dsn_evidence,
+    },
     {0},
 };
 
