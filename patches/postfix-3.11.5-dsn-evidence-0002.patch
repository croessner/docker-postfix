+/* open_test_state - allocate state with a writable queue stream */
+
+static CLEANUP_STATE *open_test_state(void)
+{
+    CLEANUP_STATE *state = cleanup_state_alloc((VSTREAM *) 0);
+
+    state->queue_id = mystrdup("TEST");
+    if ((state->dst = vstream_fopen("/dev/null", O_WRONLY, 0)) == 0)
+	msg_fatal("vstream_fopen(\"/dev/null\", O_WRONLY, 0): %m");
+    return (state);
+}
+
+/* close_test_state - close queue stream and release state */
+
+static void close_test_state(CLEANUP_STATE *state)
+{
+    (void) vstream_fclose(state->dst);
+    state->dst = 0;
+    cleanup_state_free(state);
+}
+
+/* accepts_trusted_dsn_evidence - accept and absorb trusted attributes */
+
+static int accepts_trusted_dsn_evidence(const TEST_CASE *tp)
+{
+    CLEANUP_STATE *state = open_test_state();
+    int     result = PASS;
+
+    state->dsn_evidence_allowed = 1;
+    cleanup_envelope(state, REC_TYPE_ATTR,
+		     MAIL_ATTR_DSN_ORIG_QUEUEID "=ABC123",
+		     sizeof(MAIL_ATTR_DSN_ORIG_QUEUEID "=ABC123") - 1);
+    CLEANUP_RECORD(state, REC_TYPE_ATTR,
+		   MAIL_ATTR_DSN_ORIG_ENVELOPE "=AQABYQABAAFy",
+		   sizeof(MAIL_ATTR_DSN_ORIG_ENVELOPE "=AQABYQABAAFy") - 1);
+    if (state->errs != CLEANUP_STAT_OK
+	|| state->dsn_original_queue_id == 0
+	|| strcmp(state->dsn_original_queue_id, "ABC123") != 0
+	|| state->dsn_original_envelope == 0
+	|| strcmp(state->dsn_original_envelope, "AQABYQABAAFy") != 0
+	|| nvtable_find(state->attr, MAIL_ATTR_DSN_ORIG_QUEUEID) != 0
+	|| nvtable_find(state->attr, MAIL_ATTR_DSN_ORIG_ENVELOPE) != 0) {
+	msg_warn("trusted DSN evidence was not accepted and absorbed");
+	result = FAIL;
+    }
+    close_test_state(state);
+    return (result);
+}
+
+/* rejects_untrusted_dsn_evidence - reject evidence on public cleanup */
+
+static int rejects_untrusted_dsn_evidence(const TEST_CASE *tp)
+{
+    CLEANUP_STATE *state = open_test_state();
+    int     result;
+
+    cleanup_envelope(state, REC_TYPE_ATTR,
+		     MAIL_ATTR_DSN_ORIG_QUEUEID "=ABC123",
+		     sizeof(MAIL_ATTR_DSN_ORIG_QUEUEID "=ABC123") - 1);
+    result = (state->errs & CLEANUP_STAT_BAD) != 0 ? PASS : FAIL;
+    close_test_state(state);
+    return (result);
+}
+
+/* rejects_duplicate_dsn_evidence - reject duplicate trusted attributes */
+
+static int rejects_duplicate_dsn_evidence(const TEST_CASE *tp)
+{
+    CLEANUP_STATE *state = open_test_state();
+    int     result;
+
+    state->dsn_evidence_allowed = 1;
+    cleanup_envelope(state, REC_TYPE_ATTR,
+		     MAIL_ATTR_DSN_ORIG_QUEUEID "=ABC123",
+		     sizeof(MAIL_ATTR_DSN_ORIG_QUEUEID "=ABC123") - 1);
+    CLEANUP_RECORD(state, REC_TYPE_ATTR,
+		   MAIL_ATTR_DSN_ORIG_QUEUEID "=DEF456",
+		   sizeof(MAIL_ATTR_DSN_ORIG_QUEUEID "=DEF456") - 1);
+    result = (state->errs & CLEANUP_STAT_BAD) != 0 ? PASS : FAIL;
+    close_test_state(state);
+    return (result);
+}
+
+/* rejects_incomplete_dsn_evidence - require the complete attribute pair */
+
+static int rejects_incomplete_dsn_evidence(const TEST_CASE *tp)
+{
+    CLEANUP_STATE *state = open_test_state();
+    int     result;
+
+    state->dsn_evidence_allowed = 1;
+    cleanup_envelope(state, REC_TYPE_ATTR,
+		     MAIL_ATTR_DSN_ORIG_QUEUEID "=ABC123",
+		     sizeof(MAIL_ATTR_DSN_ORIG_QUEUEID "=ABC123") - 1);
+    state->sender = mystrdup("");
+    state->arrival_time.tv_sec = 1;
+    CLEANUP_RECORD(state, REC_TYPE_MESG, "", 0);
+    result = (state->errs & CLEANUP_STAT_BAD) != 0 ? PASS : FAIL;
+    close_test_state(state);
+    return (result);
+}
+
+/* rejects_malformed_dsn_evidence - require unpadded base64url */
+
+static int rejects_malformed_dsn_evidence(const TEST_CASE *tp)
+{
+    CLEANUP_STATE *state = open_test_state();
+    int     result;
+
+    state->dsn_evidence_allowed = 1;
+    cleanup_envelope(state, REC_TYPE_ATTR,
+		     MAIL_ATTR_DSN_ORIG_ENVELOPE "=AQABYQ==",
+		     sizeof(MAIL_ATTR_DSN_ORIG_ENVELOPE "=AQABYQ==") - 1);
+    result = (state->errs & CLEANUP_STAT_BAD) != 0 ? PASS : FAIL;
+    close_test_state(state);
+    return (result);
+}
+
 static const TEST_CASE test_cases[] = {
