+/* post_mail_fopen_dsn_nowait - prepare a DSN without waiting for cleanup */
+
+VSTREAM *post_mail_fopen_dsn_nowait(const char *sender, const char *recipient,
+			                    int source_class, int trace_flags,
+			                    int sendopts, VSTRING *queue_id,
+			                    const char *original_queue_id,
+			                    const char *original_envelope)
+{
+    VSTREAM *stream;
+
+    if (original_queue_id == 0 || original_envelope == 0)
+	msg_panic("post_mail_fopen_dsn_nowait: null evidence argument");
+    if ((stream = mail_connect(MAIL_CLASS_PRIVATE,
+			       MAIL_SERVICE_DSN_CLEANUP, BLOCKING)) != 0)
+	post_mail_init(stream, sender, recipient, source_class, trace_flags,
+		       sendopts, queue_id, original_queue_id, original_envelope);
+    else
+	msg_warn("connect to %s/%s: %m", MAIL_CLASS_PRIVATE,
+		 MAIL_SERVICE_DSN_CLEANUP);
+    return (stream);
+}
+
 /* post_mail_fopen_nowait - prepare for posting a message */
 
