+/* cleanup_milter_eval_event - expand event-specific macro */
+
+static const char *cleanup_milter_eval_event(const char *name, int event,
+			                     void *ptr)
+{
+    CLEANUP_STATE *state = (CLEANUP_STATE *) ptr;
+
+    if (event == MILTER_MACRO_EVENT_EOH
+	&& state->dsn_original_queue_id != 0
+	&& state->dsn_original_envelope != 0) {
+	if (strcmp(name, "{postfix_dsn_evidence}") == 0)
+	    return ("postfix-dsn-evidence-v1");
+	if (strcmp(name, "{postfix_dsn_original_queue_id}") == 0)
+	    return (state->dsn_original_queue_id);
+	if (strcmp(name, "{postfix_dsn_original_envelope}") == 0)
+	    return (state->dsn_original_envelope);
+    }
+    return (cleanup_milter_eval(name, ptr));
+}
