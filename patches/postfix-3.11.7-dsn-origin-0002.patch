 root_tests:
 
+cleanup_milter_dsn_origin_test: cleanup_milter \
+	cleanup_milter_dsn_origin.in cleanup_milter_dsn_origin.ref
+	$(SHLIB_ENV) $(VALGRIND) ./cleanup_milter \
+	    <cleanup_milter_dsn_origin.in >cleanup_milter_dsn_origin.tmp 2>&1
+	diff cleanup_milter_dsn_origin.ref cleanup_milter_dsn_origin.tmp
+	rm -f cleanup_milter_dsn_origin.tmp
+
 cleanup_masquerade_test: cleanup_masquerade cleanup_masq.ref
 	rm -f cleanup_masq.tmp
 	$(SHLIB_ENV) $(VALGRIND) ./cleanup_masquerade '' a.b.c,b.c xxx@aa.a.b.c    >>cleanup_masq.tmp
diff --git a/src/cleanup/cleanup_milter.c b/src/cleanup/cleanup_milter.c
index 9c894d7e6..d196f2d1b 100644
--- a/src/cleanup/cleanup_milter.c
+++ b/src/cleanup/cleanup_milter.c
@@ -236,6 +236,10 @@ static const char *cleanup_add_rcpt_par(void *, const char *, const char *);
 #define STR(x)		vstring_str(x)
 #define LEN(x)		VSTRING_LEN(x)
 
+#define CLEANUP_DSN_ORIGIN_MACRO	"{postfix_dsn_origin}"
+#define CLEANUP_DSN_ORIGIN_INTERNAL	"internal"
+#define CLEANUP_DSN_ORIGIN_EXTERNAL	"external"
+
 /* cleanup_milter_hbc_log - log post-milter header/body_checks action */
 
 static void cleanup_milter_hbc_log(void *context, const char *action,
@@ -1932,6 +1936,9 @@ static const char *cleanup_milter_eval(const char *name, void *ptr)
 	return (var_milt_daemon_name);
     if (strcmp(name, S8_MAC_V) == 0)
 	return (var_milt_v);
+    if (strcmp(name, CLEANUP_DSN_ORIGIN_MACRO) == 0)
+	return ((state->flags & CLEANUP_FLAG_DSN_ORIGIN) ?
+		CLEANUP_DSN_ORIGIN_INTERNAL : CLEANUP_DSN_ORIGIN_EXTERNAL);
 
     /*
      * Connect macros.
@@ -2403,6 +2410,7 @@ static void usage(void)
 {
     msg_warn("usage:");
     msg_warn("    verbose on|off");
+    msg_warn("    dsn_origin internal|external");
     msg_warn("    open pathname");
     msg_warn("    close");
     msg_warn("    add_header index name [value]");
@@ -2612,6 +2620,25 @@ int     main(int unused_argc, char **argv)
 	    } else if ((var_line_limit = atoi(argv->argv[1])) < DEF_LINE_LIMIT) {
 		msg_warn("bad line_length_limit argument");
 	    }
+	} else if (strcmp(argv->argv[0], "dsn_origin") == 0) {
+	    if (argv->argc != 2) {
+		msg_warn("bad dsn_origin argument count: %ld",
+			 (long) argv->argc);
+	    } else if (strcmp(argv->argv[1], CLEANUP_DSN_ORIGIN_INTERNAL) == 0) {
+		state->flags |= CLEANUP_FLAG_DSN_ORIGIN;
+		vstream_printf("%s=%s\n", CLEANUP_DSN_ORIGIN_MACRO,
+			       cleanup_milter_eval(CLEANUP_DSN_ORIGIN_MACRO,
+						   (void *) state));
+		vstream_fflush(VSTREAM_OUT);
+	    } else if (strcmp(argv->argv[1], CLEANUP_DSN_ORIGIN_EXTERNAL) == 0) {
+		state->flags &= ~CLEANUP_FLAG_DSN_ORIGIN;
+		vstream_printf("%s=%s\n", CLEANUP_DSN_ORIGIN_MACRO,
+			       cleanup_milter_eval(CLEANUP_DSN_ORIGIN_MACRO,
+						   (void *) state));
+		vstream_fflush(VSTREAM_OUT);
+	    } else {
+		msg_warn("bad dsn_origin value: %s", argv->argv[1]);
+	    }
 	} else if (strcmp(argv->argv[0], "open") == 0) {
 	    if (state->dst != 0) {
 		msg_info("closing %s", VSTREAM_PATH(state->dst));
