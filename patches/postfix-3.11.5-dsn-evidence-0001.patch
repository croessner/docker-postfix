diff --git a/src/milter/milter_macro_test.c b/src/milter/milter_macro_test.c
new file mode 100644
index 0000000..569d163
--- /dev/null
+++ b/src/milter/milter_macro_test.c
@@ -0,0 +1,172 @@
+/*++
+/* NAME
+/*	milter_macro_test 1t
+/* SUMMARY
+/*	Milter macro callback unit test
+/* SYNOPSIS
+/*	./milter_macro_test
+/* DESCRIPTION
+/*	milter_macro_test verifies event-aware macro lookup and compatibility
+/*	with the legacy macro lookup callback.
+/* LICENSE
+/* .ad
+/* .fi
+/*	The Secure Mailer license must be distributed with this software.
+/*--*/
+
+ /*
+  * System library.
+  */
+#include <sys_defs.h>
+#include <string.h>
+
+ /*
+  * Utility library.
+  */
+#include <argv.h>
+#include <msg.h>
+#include <msg_vstream.h>
+#include <vstream.h>
+
+ /*
+  * Application-specific.
+  */
+#include "milter.h"
+
+static int event_log[16];
+static int event_count;
+static int legacy_count;
+
+static void fail(const char *text)
+{
+    msg_fatal("%s", text);
+}
+
+static void check_macros(ARGV *macros)
+{
+    if (macros == 0 || macros->argc != 2
+	|| strcmp(macros->argv[0], "test") != 0
+	|| strcmp(macros->argv[1], "value") != 0)
+	fail("unexpected macro lookup result");
+}
+
+static const char *event_lookup(const char *name, int event, void *unused)
+{
+    if (strcmp(name, "{test}") != 0)
+	fail("unexpected macro lookup name");
+    event_log[event_count++] = event;
+    return ("value");
+}
+
+static const char *legacy_lookup(const char *name, void *unused)
+{
+    if (strcmp(name, "{test}") != 0)
+	fail("unexpected legacy macro lookup name");
+    legacy_count++;
+    return ("value");
+}
+
+static const char *conn_event(MILTER *unused, const char *name,
+		              const char *addr, const char *port,
+		              unsigned family, ARGV *macros)
+{
+    check_macros(macros);
+    return (0);
+}
+
+static const char *helo_event(MILTER *unused, const char *name,
+		              int esmtp, ARGV *macros)
+{
+    check_macros(macros);
+    return (0);
+}
+
+static const char *mail_event(MILTER *unused, const char **argv, ARGV *macros)
+{
+    check_macros(macros);
+    return (0);
+}
+
+static const char *rcpt_event(MILTER *unused, const char **argv, ARGV *macros)
+{
+    check_macros(macros);
+    return (0);
+}
+
+static const char *data_event(MILTER *unused, ARGV *macros)
+{
+    check_macros(macros);
+    return (0);
+}
+
+static const char *unknown_event(MILTER *unused, const char *command,
+		                 ARGV *macros)
+{
+    check_macros(macros);
+    return (0);
+}
+
+static const char *message_event(MILTER *unused, VSTREAM *fp,
+		                 off_t offset, ARGV *eoh_macros,
+		                 ARGV *eom_macros, ARGV *auto_hdrs)
+{
+    check_macros(eoh_macros);
+    check_macros(eom_macros);
+    return (0);
+}
+
+static void check_event(int offset, int expected)
+{
+    if (event_count <= offset || event_log[offset] != expected)
+	fail("unexpected macro lookup event");
+}
+
+int main(int argc, char **argv)
+{
+    MILTER_MACROS macros;
+    MILTERS milters;
+    MILTER milter;
+    const char *args[] = { "address", 0 };
+
+    msg_vstream_init(argv[0], VSTREAM_ERR);
+    memset(&macros, 0, sizeof(macros));
+    macros.conn_macros = macros.helo_macros = macros.mail_macros = "test";
+    macros.rcpt_macros = macros.data_macros = macros.eoh_macros = "test";
+    macros.eod_macros = macros.unk_macros = "test";
+    memset(&milters, 0, sizeof(milters));
+    memset(&milter, 0, sizeof(milter));
+    milters.milter_list = &milter;
+    milters.macros = &macros;
+    milter.conn_event = conn_event;
+    milter.helo_event = helo_event;
+    milter.mail_event = mail_event;
+    milter.rcpt_event = rcpt_event;
+    milter.data_event = data_event;
+    milter.unknown_event = unknown_event;
+    milter.message = message_event;
+
+    milter_macro_callback_event(&milters, event_lookup, 0);
+    (void) milter_conn_event(&milters, "name", "addr", "port", 0);
+    (void) milter_helo_event(&milters, "name", 0);
+    (void) milter_mail_event(&milters, args);
+    (void) milter_rcpt_event(&milters, 0, args);
+    (void) milter_data_event(&milters);
+    (void) milter_unknown_event(&milters, "command");
+    (void) milter_message(&milters, 0, 0, 0);
+    if (event_count != 8)
+	fail("unexpected macro lookup event count");
+    check_event(0, MILTER_MACRO_EVENT_CONNECT);
+    check_event(1, MILTER_MACRO_EVENT_HELO);
+    check_event(2, MILTER_MACRO_EVENT_MAIL);
+    check_event(3, MILTER_MACRO_EVENT_RCPT);
+    check_event(4, MILTER_MACRO_EVENT_DATA);
+    check_event(5, MILTER_MACRO_EVENT_UNKNOWN);
+    check_event(6, MILTER_MACRO_EVENT_EOH);
+    check_event(7, MILTER_MACRO_EVENT_EOM);
+
+    milter_macro_callback(&milters, legacy_lookup, 0);
+    (void) milter_data_event(&milters);
+    if (legacy_count != 1)
+	fail("legacy macro lookup callback not used");
+    return (0);
+}
